{
    "name": "akshitarora/dblog",
    "description": "Tool to log heavy database queries in the Laravel application",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Akshit Arora",
            "email": "akshit.arora0907@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "AkshitArora\\DbLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AkshitArora\\DbLog\\Tests\\" : "tests"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "composer/composer": "^2.1",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0 || ^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AkshitArora\\DbLog\\DbLogServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        }
    }
}
